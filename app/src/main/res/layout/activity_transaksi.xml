<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".TransaksiActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftar Transaksi"
        android:textSize="20sp"
        android:textStyle="bold">
    </TextView>

    <EditText
        android:id="@+id/etCari"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Cari kategori / keterangan">
    </EditText>

    <RadioGroup
        android:id="@+id/rgFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbSemua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Semua">
        </RadioButton>

        <RadioButton
            android:id="@+id/rbFilterPemasukan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pemasukan">
        </RadioButton>

        <RadioButton
            android:id="@+id/rbFilterPengeluaran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengeluaran">
        </RadioButton>
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Urutkan">
    </TextView>

    <Spinner
        android:id="@+id/spUrut"
        android:layout_width="match_parent"
        android:layout_height="48dp">
    </Spinner>

    <Button
        android:id="@+id/btnTerapkan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Terapkan">
    </Button>

    <TextView
        android:id="@+id/tvInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Menampilkan 0 transaksi">
    </TextView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSemuaTransaksi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    </androidx.recyclerview.widget.RecyclerView>

</LinearLayout>