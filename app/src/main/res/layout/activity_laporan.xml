<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".LaporanActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Laporan Bulanan"
        android:textSize="20sp"
        android:textStyle="bold">
    </TextView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bulan">
    </TextView>

    <Spinner
        android:id="@+id/spBulan"
        android:layout_width="match_parent"
        android:layout_height="48dp">
    </Spinner>

    <EditText
        android:id="@+id/etTahun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tahun"
        android:inputType="number">
    </EditText>

    <Button
        android:id="@+id/btnHitung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hitung">
    </Button>

    <TextView
        android:id="@+id/tvPeriode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Periode : -"
        android:textStyle="bold">
    </TextView>

    <TextView
        android:id="@+id/tvLapPemasukan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Pemasukan : Rp 0"
        android:textColor="#2E7D32">
    </TextView>

    <TextView
        android:id="@+id/tvLapPengeluaran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total Pengeluaran : Rp 0"
        android:textColor="#C62828">
    </TextView>

    <TextView
        android:id="@+id/tvLapSelisih"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selisih : Rp 0"
        android:textStyle="bold">
    </TextView>

    <TextView
        android:id="@+id/tvLapJumlah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Jumlah Transaksi : 0">
    </TextView>

</LinearLayout>