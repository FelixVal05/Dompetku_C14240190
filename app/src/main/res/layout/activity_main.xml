<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvJudul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="DompetKu"
        android:textSize="24sp"
        android:textStyle="bold">
    </TextView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Saldo Saat Ini">
    </TextView>

    <TextView
        android:id="@+id/tvSaldo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="Rp 0"
        android:textSize="28sp"
        android:textStyle="bold">
    </TextView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Pemasukan">
            </TextView>

            <TextView
                android:id="@+id/tvTotalPemasukan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#2E7D32"
                android:textSize="16sp"
                android:textStyle="bold">
            </TextView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Pengeluaran">
            </TextView>

            <TextView
                android:id="@+id/tvTotalPengeluaran"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#C62828"
                android:textSize="16sp"
                android:textStyle="bold">
            </TextView>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvJumlahTransaksi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="0 transaksi">
    </TextView>

    <Button
        android:id="@+id/btnKategori"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kategori">
    </Button>

    <Button
        android:id="@+id/btnPemasukan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pemasukan">
    </Button>

    <Button
        android:id="@+id/btnPengeluaran"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pengeluaran">
    </Button>

    <Button
        android:id="@+id/btnTransaksi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Daftar Transaksi">
    </Button>

    <Button
        android:id="@+id/btnLaporan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Laporan Bulanan">
    </Button>

</LinearLayout>